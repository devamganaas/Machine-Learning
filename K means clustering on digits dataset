    {
      "cell_type": "code",
      "source": [
        "from sklearn.datasets import load_digits\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.metrics import silhouette_score\n",
        ""
      ],
      "metadata": {
        "id": "1ZB6JIKsPh1d"
      },
      "execution_count": 10,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Load dataset\n",
        "digits = load_digits()\n",
        "X = digits.data\n",
        ""
      ],
      "metadata": {
        "id": "TDKMbrh8Ph4s"
      },
      "execution_count": 11,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Standardize data\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X)\n",
        ""
      ],
      "metadata": {
        "id": "KC80SnmYUafb"
      },
      "execution_count": 12,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Different K values\n",
        "k_values = [8, 10, 12]\n",
        "\n",
        "for k in k_values:\n",
        "\n",
        "    kmeans = KMeans(\n",
        "        n_clusters=k,\n",
        "        random_state=42,\n",
        "        n_init=10\n",
        "    )\n",
        "\n",
        "    labels = kmeans.fit_predict(X_scaled)\n",
        "\n",
        "    inertia = kmeans.inertia_\n",
        "\n",
        "    silhouette = silhouette_score(\n",
        "        X_scaled, labels\n",
        "    )\n",
        "\n",
        "    print(\"K =\", k)\n",
        "    print(\"Inertia =\", round(inertia, 2))\n",
        "    print(\n",
        "        \"Silhouette Score =\",\n",
        "        round(silhouette, 4)\n",
        "    )\n",
        "    print()"
      ],
